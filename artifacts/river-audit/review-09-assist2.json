  "events": [
    {
      "id": "river-v270-y-918-p24",
      "year": -918,
      "categories": [
        "war"
      ],
      "title": "晋军涉水击败梁军并攻取滨河四寨",
      "sources": [
        {
          "volume": 270,
          "year": -918,
          "anchor": 24,
          "quote": "甲子，王引亲军先涉，诸军随之，褰甲横枪，结陈而进。是日水落，深纔及膝。匡国节度使、北面行营排陈使谢彦章帅众临岸拒之，晋兵不得进，乃稍引却，梁兵从之。及中流，鼓噪复进，彦章不能支，稍退登岸；晋兵因而乘之，梁兵大败，死伤不可胜纪，河水为之赤，彦章仅以身免。是日，晋人遂陷滨河四寨。",
          "candidateId": "v270-y-918-p24"
        }
      ],
      "status": "reviewed",
      "reason": "涉水交战并攻取四寨。"
    },
    {
      "id": "river-v270-y-918-p31",
      "year": -918,
      "categories": [
        "war"
      ],
      "title": "晋军集结诸镇及部落兵并在魏州大阅",
      "sources": [
        {
          "volume": 270,
          "year": -918,
          "anchor": 31,
          "quote": "晋王谋大举入寇，周德威将幽州步骑三万，李存审将沧景步骑万人，李嗣源将邢洺步骑万人，王处直遣将将易定步骑万人，及麟、胜、云、蔚、新、武等州诸部落奚、契丹、室韦、吙谷浑，皆以兵会之。八月，井河东魏博之兵，大阅于魏州。",
          "candidateId": "v270-y-918-p31"
        }
      ],
      "status": "reviewed",
      "reason": "各镇及部落兵实际会集并大阅。"
    },
    {
      "id": "river-v270-y-918-p36",
      "year": -918,
      "categories": [
        "war"
      ],
      "title": "晋军进军郓、濮并驻麻家渡与梁军对峙",
      "sources": [
        {
          "volume": 270,
          "year": -918,
          "anchor": 36,
          "quote": "晋王自魏州如杨刘，引兵略郓、濮而还，循河而上，军于麻家渡。贺緕、谢彦章将梁兵屯濮州北行台村，相持不战。",
          "candidateId": "v270-y-918-p36"
        }
      ],
      "status": "reviewed",
      "reason": "晋军实际进军驻守与梁军对峙。"
    },
    {
