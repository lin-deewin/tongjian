# Copy to backend/.env for local use. Real production values belong in /etc/tongjian-commerce/commerce.env.
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://tongjian:local-development-only@127.0.0.1:55432/tongjian_commerce
TEST_DATABASE_URL=postgresql://tongjian:local-development-only@127.0.0.1:55432/tongjian_commerce_test
SITE_URL=http://127.0.0.1:8010
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=replace-with-independent-random-secret-at-least-40-characters
OTP_HMAC_KEY=replace-with-independent-random-secret-at-least-32-characters
PAYMENT_PROVIDER=disabled
PAYMENT_SCENES=native,h5
SALES_ENABLED=false
COMMERCE_LIVE_READY=false
PAYMENT_VERIFICATION_ENABLED=false
PAYMENT_VERIFICATION_BUYERS=
PAYMENT_VERIFICATION_PRICE_FEN=0
ADMIN_NETWORKS=127.0.0.1/32,::1/128
TRUSTED_PROXY_NETWORKS=
TRUST_HTTPS_PROXY=false
CONTENT_ROOT=
STATIC_ROOT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.invalid
EMAIL_MESSAGE_ID_DOMAIN=deewins.top
# Keep disabled for standard verified registration + password login.
LEGACY_EMAIL_LOGIN_ENABLED=false
OTP_SUBNET_LIMIT=100
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_API_V3_KEY=
# JSON mapping trusted platform public-key ID to an absolute PEM public-key path. Install rotations before use.
WECHAT_PUBLIC_KEYS_FILE=
LAUNCH_GATES_FILE=
TERMS_FILE=
OPERATOR_EMAIL=
