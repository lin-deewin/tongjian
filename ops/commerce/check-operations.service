[Unit]
Description=Monitor current Tongjian transaction, mail and content issues
After=tongjian-commerce.service
OnFailure=tongjian-commerce-alert@%n.service

[Service]
Type=oneshot
RuntimeDirectory=tongjian-commerce-tasks
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
User=tongjian-commerce
Group=tongjian-commerce
WorkingDirectory=/srv/tongjian-commerce/current/backend
EnvironmentFile=/etc/tongjian-commerce/commerce.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/usr/bin/flock -n /run/tongjian-commerce-tasks/monitor.lock /srv/tongjian-commerce/venv/bin/python manage.py check_operations
TimeoutStartSec=90
NoNewPrivileges=true
