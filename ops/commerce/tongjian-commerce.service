[Unit]
Description=Tongjian paid content service
After=network.target postgresql.service
OnFailure=tongjian-commerce-alert@%n.service

[Service]
User=tongjian-commerce
Group=tongjian-commerce
WorkingDirectory=/srv/tongjian-commerce/current/backend
EnvironmentFile=/etc/tongjian-commerce/commerce.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStartPre=/srv/tongjian-commerce/venv/bin/python manage.py check --deploy --fail-level WARNING
ExecStart=/srv/tongjian-commerce/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8010 --workers 2 --timeout 30 --error-logfile - --access-logfile /dev/null
Restart=on-failure
RestartSec=5
RuntimeDirectory=tongjian-commerce
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
