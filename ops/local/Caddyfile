{
	admin off
	auto_https off
}

http://:3003 {
	bind tcp4/0.0.0.0
	@accounts path /tongjian/account /tongjian/account/* /tongjian/api/* /tongjian/checkout/* /tongjian/article/* /tongjian/admin/*
	handle @accounts {
		header >Cache-Control "private, no-store"
		reverse_proxy 127.0.0.1:18010 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /tongjian/admin-static/* {
		root * tmp/commerce-static
		file_server
	}
	redir /tongjian /tongjian/ 308
	handle_path /tongjian/* {
		root * dist
		encode zstd gzip
		file_server
	}
	# Preserve old root-level bookmarks, queries and browser fragments by
	# moving them to the same /tongjian/ prefix used by the account pages.
	handle {
		redir * /tongjian{uri} 308
	}
}
